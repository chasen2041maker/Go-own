# 仅供查看变量结构；程序不会自动加载本文件。
# 必填秘密保持为空，避免公开占位串被误当成安全默认值。

# Reference API 运行时配置
HTTP_ADDR=127.0.0.1:8084
DATABASE_DSN=
JWT_SECRET=
JWT_ISSUER=investment-community
JWT_AUDIENCE=investment-community-api

# 所有超时都必须是正数 Go duration。
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
READINESS_TIMEOUT=2s

# 虚构演示 Seed 必须显式确认，且密码不得提交到仓库。
SEED_CONFIRM=
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=

# Integration 测试必须使用专用、可丢弃的 MySQL schema。
# 示例 DSN 形状（不要原样使用）：
# community_test:LOCAL_PASSWORD@tcp(127.0.0.1:3306)/investment_community_test?parseTime=true&loc=UTC
COMMUNITY_TEST_DSN=

# 测试会重置其专用 schema；确认目标后才在当前 shell 中改成 1。
COMMUNITY_TEST_ALLOW_RESET=0

# Compose 本地覆盖；留空时 compose.yaml 使用明确标注的虚构本地默认值。
COMMUNITY_MYSQL_PASSWORD=
COMMUNITY_MYSQL_ROOT_PASSWORD=
COMMUNITY_JWT_SECRET=
COMMUNITY_ADMIN_PASSWORD=
COMMUNITY_USER_PASSWORD=
COMMUNITY_API_PORT=8084
COMMUNITY_MYSQL_PORT=13385
COMMUNITY_SWAGGER_PORT=8085

# 纯 HTTP acceptance 连接已经启动并完成 Seed 的 API。
COMMUNITY_ACCEPTANCE_BASE_URL=
COMMUNITY_ACCEPTANCE_ADMIN_EMAIL=admin@starharbor.example.test
COMMUNITY_ACCEPTANCE_ADMIN_PASSWORD=
